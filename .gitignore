# --- Next.js Build & Cache ---
.next/
out/
build/
# Turbopack cache
.turbo/

# --- Dependencies ---
node_modules/
# Use these if you use pnpm or yarn
.pnpm-debug.log*
yarn-error.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# --- Environment Variables (CRITICAL) ---
# Never push your actual secrets!
.env
*.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Docker ---
# Ignore local Docker data but keep the Dockerfile
.docker/
docker-compose.override.yml

# --- IDE & System Files ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# --- Logs & Debugging ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
*.log
